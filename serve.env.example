# ==============================================================================
# Environment Configuration Template for Qwen3.8-27B Serving
# ==============================================================================
# Copy this file to '.env' or 'serve.env' in the repo root to customize settings.
# Both serve.sh and build.sh will automatically load it if present.
# Command-line arguments to scripts always take precedence over these values.

# ------------------------------------------------------------------------------
# Model Configuration
# ------------------------------------------------------------------------------
# Path to the Qwen3.8-27B GGUF file. Must contain blk.64 for MTP support.
# Default looks in common locations or ./models/
MODEL="/ssd-storage/llm-models/Qwen3.8-27B-UD-Q4_K_M.gguf"

# ------------------------------------------------------------------------------
# Build & Binary Directories
# ------------------------------------------------------------------------------
# Directory containing built binaries (subdirectories: stock/ and patched/)
# Default: ./builds
BUILDS_DIR="./builds"

# Direct override to llama-server binary (optional)
# LLAMA_SERVER_BIN=""

# Upstream llama.cpp source directory for build.sh
# LLAMACPP_SRC="./llama.cpp"

# ------------------------------------------------------------------------------
# Toolchain Paths (Optional)
# ------------------------------------------------------------------------------
# Only needed if CUDA 12.x or GCC 11-13 are not in default system paths (/usr/local/cuda)
# or if your host compiler is newer than GCC 13 (e.g. GCC 14/15/16).
# CUDA_HOME="/usr/local/cuda-12.9"
# GCC_HOME="/usr/local/gcc-13"

# ------------------------------------------------------------------------------
# GPU & Serving Settings
# ------------------------------------------------------------------------------
# GPU index to expose via CUDA_VISIBLE_DEVICES.
# Must point to your sm_70 GPU (e.g. Tesla V100).
CUDA_VISIBLE_DEVICES="0"

# Context length in tokens (default: 131072 = 128K context)
CTX="131072"

# Network binding
HOST="127.0.0.1"
PORT="8080"

# Multi-Token Prediction (1 = enabled / stock build; 0 = disabled / T2-001 patched build)
MTP=1

# Maximum draft tokens for MTP (default: 3; set to 7 for pure 128K context workloads)
DRAFT_MAX=3

# Additional llama-server arguments passed directly to exec
# EXTRA_ARGS=""
